+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#ifndef ENGINES_REMASTER_LAYER_H
+#define ENGINES_REMASTER_LAYER_H
+
+#include "audio/mixer.h"
+#include "common/events.h"
+#include "common/file.h"
+#include "common/hashmap.h"
+#include "common/str-enc.h"
+#include "common/str.h"
+#include "graphics/surface.h"
+
+#include "engines/remaster/assetpack.h"
+#include "engines/remaster/compositor.h"
+#include "engines/remaster/keys.h"
+
+namespace Remaster {
+
+/**
+ * Remaster Layer: HD graphics, 16:9, smooth scrolling, corrected/translated
+ * texts and recorded voices for 8-bit adventure engines, switchable to the
+ * original at any moment (F8 by default).
+ *
+ * Integration (see engine/scummvm-remaster-layer/INTEGRAZIONE.md):
+ *   init     Layer *l = Layer::create(desc); if (!l) initGraphics(w, h);
+ *   scene    l->setBackground(name, bg8, rgb, x, y);
+ *   palette  l->setPalette(rgb, start, n) instead of the PaletteManager
+ *   frame    l->beginScene(bbW, bbH); blitters: slot = l->beginSprite(...); l->mark(...)
+ *   texts    if (!l->addText(font, x, y, s, color, outline, boxW)) <draw as before>
+ *   show     l->present(bb8, scrollX, scrollY); l->pace(tickMs) instead of delayMillis
+ *   input    for every polled event: if (l->handleEvent(ev)) continue;
+ *            l->warpMouse(x, y) instead of g_system->warpMouse
+ *   strings  s = l->text(original); l->playVoice(original)
+ */
+class Layer {
+public:
+	struct Desc {
+		Common::String gameId;
+		int screenW = 320, screenH = 200;
+		/**
+		 * Pixel height / width on the monitor the game was made for. 1.0: square pixels
+		 * (320x200 -> 18 px per side in 16:9). 1.2: 320x200 shown at 4:3; the rows are then
+		 * stretched (320x200 at scale 3 -> 960x720, 54 px per side in 16:9) unless
+		 * remaster_aspect=false.
+		 */
+		float pixelAspect = 1.0f;
+		Common::CodePage codePage = Common::kDos850;
+		Common::String language;			///< "it", "en"... (empty: from the ScummVM settings)
+	};
+
+	/**
+	 * Initializes the graphics mode when a remaster pack is installed and the
+	 * remaster is enabled; returns nullptr otherwise (the engine then calls
+	 * initGraphics() as usual).
+	 */
+	static Layer *create(const Desc &desc);
+	~Layer();
+
+	bool classic() const { return _comp->classic(); }
+	void setClassic(bool c);
+	void toggle();
+	int scale() const { return _comp->scale(); }
+
+	// --- graphics -------------------------------------------------------
+	void setPalette(const byte *rgb, uint start, uint num);
+	void setBackground(const Common::String &scene, const Graphics::Surface &bg8, const byte *rgb, int bgX = 0, int bgY = 0);
+	void beginScene(int bbW, int bbH);
+	/** call before blitting a sprite frame; returns its slot (0: drawn as original) */
+	uint32 beginSprite(const byte *pixels, int w, int h, int pitch, byte transparent);
+	/** call for every pixel the blitter writes: (x, y) in the back buffer, (sx, sy) in the frame */
+	inline void mark(int x, int y, int sx, int sy) {
+		if (_ids && x >= 0 && y >= 0 && x < _idW && y < _idH)
+			_ids[y * _idW + x] = (_slot && sx < 1024 && sy < 1024) ? ((_slot << 20) | (sx << 10) | sy) : 0;
+	}
+	void endSprite() { _slot = 0; }
+	/** the engine copied plain pixels over an area (no sprite): forget the sprite ids there */
+	void clearArea(int x, int y, int w, int h);
+
+	int font(const Common::String &name);
+	/** true if drawn in HD (the engine must then skip its own rasterization) */
+	bool addText(int font, int x, int y, const Common::String &s, byte color, byte outline = 0, int boxW = 0);
+
+	void present(const Graphics::Surface &bb8, int scrollX, int scrollY);
+	/** wait for the next logic tick, presenting interpolated frames meanwhile */
+	void pace(uint32 tickMs);
+
+	// --- input ----------------------------------------------------------
+	/** toggle key and mouse remapping; true when the event was consumed */
+	bool handleEvent(Common::Event &ev);
+	/** g_system->warpMouse() with engine screen coordinates */
+	void warpMouse(int x, int y);
+	bool aspectCorrected() const { return _aspect; }
+
+	// --- texts and voices -------------------------------------------------
+	/** corrected or translated string in the game code page (original in classic mode) */
+	Common::String text(const Common::String &original, const char *kind = "", const char *location = "", const char *speaker = "", int boxW = 0);
+	bool playVoice(const Common::String &original);
+	void stopVoice();
+	bool isVoicePlaying() const;
+
+private:
+	Layer(const Desc &desc, AssetPack *pack, int scale, const Graphics::PixelFormat &fmt);
+
+	Desc _desc;
+	AssetPack *_pack;
+	Compositor *_comp;
+	Graphics::PixelFormat _fmt;
+	bool _widescreen;
+	bool _aspect;
+	bool _smooth;
+	bool _voices;
+	int _toggleKey;
+	Common::String _lang;
+
+	uint32 *_ids = nullptr;
+	int _idW = 0, _idH = 0;
+	uint32 _slot = 0;
+
+	// smooth scrolling
+	const Graphics::Surface *_bb = nullptr;
+	int _scrollFrom = 0, _scrollTo = 0, _scrollY = 0;
+	uint32 _tickStart = 0;
+	bool _paced = false;
+	void show(int scrollX256);
+
+	Audio::SoundHandle _voice;
+
+	// developer dump (remaster_dump=<folder>)
+	Common::String _dumpDir;
+	Common::HashMap<uint32, bool> _dumped;
+	Common::DumpFile *_textDump = nullptr;
+	byte _pal[768];
+	void dumpRaw(const Common::String &file, const byte *pixels, int w, int h, int pitch, byte transparent, const byte *pal);
+	void dumpText(const Common::String &original, const char *kind, const char *location, const char *speaker, int boxW);
+};
+
+} // End of namespace Remaster
+
+#endif
diff --git a/test/graphics/remaster.h b/test/graphics/remaster.h
new file mode 100644
index 00000000..2db890a7
--- /dev/null
+++ b/test/graphics/remaster.h
@@ -0,0 +1,302 @@
+#include <cxxtest/TestSuite.h>
+
+#include "common/config-manager.h"
+#include "common/fs.h"
+
+#include "engines/remaster/compositor.h"
+#include "engines/remaster/keys.h"
+
+#include "../system/null_osystem.h"
+
+// Remaster Layer: keys must match the pipeline tools (Python zlib.crc32),
+// the compositor must reproduce the original frame and map the mouse back,
+// localized backgrounds must win over the plain ones.
+class RemasterTestSuite : public CxxTest::TestSuite {
+	static const Graphics::PixelFormat argb() { return Graphics::PixelFormat(4, 8, 8, 8, 8, 16, 8, 0, 24); }
+
+	static uint32 px(const Graphics::Surface &s, int x, int y) { return *(const uint32 *)s.getBasePtr(x, y); }
+
+	static void touch(const Common::FSNode &dir, const char *name) {
+		delete dir.getChild(name).createWriteStream(false);
+	}
+
+	void makePalette(byte *pal) {
+		for (int i = 0; i < 256; i++) {
+			pal[i * 3] = (byte)i;
+			pal[i * 3 + 1] = (byte)(255 - i);
+			pal[i * 3 + 2] = (byte)(i / 2);
+		}
+	}
+
+public:
+	void test_keys() {
+		byte frame[13 * 5];
+		for (int i = 0; i < 13 * 5; i++)
+			frame[i] = (byte)((i * 7) % 256);
+		TS_ASSERT_EQUALS(Remaster::keyToString(Remaster::frameKey(frame, 13, 5)), Common::String("530a0dc6"));
+		TS_ASSERT_EQUALS(Remaster::keyToString(Remaster::textKey("Ciao,\\mondo! E' tardi\n")), Common::String("dd24cc89"));
+	}
+
+	void test_compose_and_classic() {
+		Remaster::AssetPack pack;	// not opened: no HD assets, upscaling only
+		Remaster::Compositor comp(pack, 3, 4, 2, argb());
+		byte pal[768];
+		makePalette(pal);
+		comp.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(4, 2, Graphics::PixelFormat::createFormatCLUT8());
+		byte *p = (byte *)bb.getPixels();
+		for (int i = 0; i < 8; i++)
+			p[i] = (byte)(10 + i);
+		comp.beginScene(4, 2);
+		const Graphics::Surface &out = comp.compose(bb, 0, 0);
+		TS_ASSERT_EQUALS(out.w, 12);
+		TS_ASSERT_EQUALS(out.h, 6);
+		Graphics::PixelFormat f = argb();
+		// a uniform 3x3 block where the neighbours don't form a diagonal edge
+		TS_ASSERT_EQUALS(px(out, 4, 1), f.RGBToColor(11, 244, 5));
+		comp.setClassic(true);
+		const Graphics::Surface &cl = comp.compose(bb, 0, 0);
+		for (int y = 0; y < 6; y++)
+			for (int x = 0; x < 12; x++) {
+				byte i = p[(y / 3) * 4 + x / 3];
+				TS_ASSERT_EQUALS(px(cl, x, y), f.RGBToColor(pal[i * 3], pal[i * 3 + 1], pal[i * 3 + 2]));
+			}
+		bb.free();
+	}
+
+	void test_widescreen_bands_and_mouse() {
+		Remaster::AssetPack pack;
+		Remaster::Compositor comp(pack, 3, 4, 2, argb());
+		comp.setMaxExtension(1, 1);
+		byte pal[768];
+		makePalette(pal);
+		comp.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(4, 2, Graphics::PixelFormat::createFormatCLUT8());
+		memset(bb.getPixels(), 200, 8);
+		comp.beginScene(4, 2);
+		const Graphics::Surface &out = comp.compose(bb, 0, 0);
+		TS_ASSERT_EQUALS(out.w, 18);
+		Graphics::PixelFormat f = argb();
+		TS_ASSERT_EQUALS(px(out, 0, 0), f.RGBToColor(0, 0, 0));		// side band (no wide picture)
+		TS_ASSERT_EQUALS(px(out, 17, 5), f.RGBToColor(0, 0, 0));
+		TS_ASSERT_EQUALS(px(out, 3, 0), f.RGBToColor(200, 55, 100));	// first game column
+		// output pixel 10 is game column (10 / 3) - 1 = 2
+		Common::Point g = comp.toGame(Common::Point(10, 4), 0);
+		TS_ASSERT_EQUALS(g.x, 2);
+		TS_ASSERT_EQUALS(g.y, 1);
+		// clicks in the bands are clamped to the game area
+		TS_ASSERT_EQUALS(comp.toGame(Common::Point(0, 0), 0).x, 0);
+		TS_ASSERT_EQUALS(comp.toGame(Common::Point(17, 0), 0).x, 3);
+		bb.free();
+	}
+
+	void test_localized_backgrounds() {
+#if NULL_OSYSTEM_IS_AVAILABLE
+		Common::install_null_g_system();
+		// pack in the build tree (test/remaster.tmp/remaster/gfx/bg), empty files are enough
+		Common::FSNode game(Common::Path("test/remaster.tmp"));
+		Common::FSNode dir = game;
+		const char *const sub[] = { "remaster", "gfx", "bg" };
+		for (uint i = 0; i <= ARRAYSIZE(sub); i++) {
+			if (!dir.exists())
+				dir.createDirectory();
+			if (i < ARRAYSIZE(sub))
+				dir = dir.getChild(sub[i]);
+		}
+		const char *const files[] = {
+			"part1_room.png", "part1_room.it.png", "part1_room.wide.png", "part1_room.it.wide.jpg",
+			"hall.jpg", "hall.wide.png", "yard.png", "yard.wide.json", "yard.it.wide.png"
+		};
+		for (uint i = 0; i < ARRAYSIZE(files); i++)
+			touch(dir, files[i]);
+		ConfMan.setPath("path", game.getPath(), Common::ConfigManager::kTransientDomain);
+		{
+			Remaster::AssetPack pack;
+			TS_ASSERT(pack.open());
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room"), "gfx/bg/part1_room");
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room", true), "gfx/bg/part1_room.wide");
+			TS_ASSERT(!pack.wideInfo("yard").hasImage);
+			pack.setLanguage("it");
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room"), "gfx/bg/part1_room.it");
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room", true), "gfx/bg/part1_room.it.wide");
+			// no localized version: the plain one
+			TS_ASSERT_EQUALS(pack.backgroundPath("hall"), "gfx/bg/hall");
+			TS_ASSERT_EQUALS(pack.backgroundPath("hall", true), "gfx/bg/hall.wide");
+			TS_ASSERT_EQUALS(pack.backgroundPath("yard"), "gfx/bg/yard");
+			TS_ASSERT(pack.wideInfo("yard").hasImage);
+			TS_ASSERT(pack.backgroundPath("cellar").empty());
+			pack.setLanguage("fr");
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room"), "gfx/bg/part1_room");
+			TS_ASSERT_EQUALS(pack.backgroundPath("part1/room", true), "gfx/bg/part1_room.wide");
+			TS_ASSERT(pack.backgroundPath("yard", true).empty());
+		}
+		ConfMan.removeKey("path", Common::ConfigManager::kTransientDomain);
+		Common::uninstall_null_g_system();
+#endif
+	}
+
+	void test_smooth_scroll_subpixel() {
+		Remaster::AssetPack pack;
+		Remaster::Compositor comp(pack, 3, 2, 1, argb());
+		byte pal[768];
+		makePalette(pal);
+		comp.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(4, 1, Graphics::PixelFormat::createFormatCLUT8());
+		byte *p = (byte *)bb.getPixels();
+		p[0] = 1; p[1] = 2; p[2] = 3; p[3] = 4;
+		comp.beginScene(4, 1);
+		Graphics::PixelFormat f = argb();
+		// scroll 1 + 1/3 pixel: the output starts one HD pixel into game column 1
+		const Graphics::Surface &out = comp.compose(bb, 256 + 86, 0);
+		TS_ASSERT_EQUALS(px(out, 0, 0), f.RGBToColor(2, 253, 1));
+		TS_ASSERT_EQUALS(px(out, 2, 0), f.RGBToColor(3, 252, 1));
+		bb.free();
+	}
+
+	// games made for non-square pixels: rows stretched by pixelAspect
+	void test_aspect_output_size_and_16_9() {
+		Remaster::AssetPack pack;
+		Remaster::Compositor comp(pack, 3, 320, 200, argb());
+		TS_ASSERT_EQUALS(comp.outputHeight(), 600);
+		comp.setAspect(1.2f);
+		TS_ASSERT(comp.stretched());
+		TS_ASSERT_EQUALS(comp.outputWidth(), 960);
+		TS_ASSERT_EQUALS(comp.outputHeight(), 720);
+		// 16:9: the view grows with the stretched height
+		TS_ASSERT_EQUALS(Remaster::Compositor::sideExtension(320, 200, 1.0f), 18);
+		TS_ASSERT_EQUALS(Remaster::Compositor::sideExtension(320, 200, 1.2f), 54);
+		TS_ASSERT_EQUALS(Remaster::Compositor::sideExtension(640, 480, 1.0f), 107);
+		comp.setMaxExtension(54, 54);
+		TS_ASSERT_EQUALS(comp.outputWidth(), 1284);
+		TS_ASSERT_DELTA((double)comp.outputWidth() / comp.outputHeight(), 16.0 / 9.0, 0.01);
+		byte pal[768];
+		makePalette(pal);
+		comp.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(320, 200, Graphics::PixelFormat::createFormatCLUT8());
+		memset(bb.getPixels(), 7, 320 * 200);
+		comp.beginScene(320, 200);
+		const Graphics::Surface &out = comp.compose(bb, 0, 0);
+		TS_ASSERT_EQUALS(out.w, 1284);
+		TS_ASSERT_EQUALS(out.h, 720);
+		Graphics::PixelFormat f = argb();
+		TS_ASSERT_EQUALS(px(out, 54 * 3, 0), f.RGBToColor(7, 248, 3));
+		TS_ASSERT_EQUALS(px(out, 1284 - 54 * 3 - 1, 719), f.RGBToColor(7, 248, 3));
+		TS_ASSERT_EQUALS(px(out, 0, 360), f.RGBToColor(0, 0, 0));	// band
+		bb.free();
+	}
+
+	void test_aspect_rows_filtered() {
+		Remaster::AssetPack pack;
+		Remaster::Compositor comp(pack, 3, 2, 5, argb());
+		comp.setAspect(1.2f);	// 5 rows x 3 x 1.2 = 18
+		byte pal[768];
+		makePalette(pal);
+		comp.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(2, 5, Graphics::PixelFormat::createFormatCLUT8());
+		for (int y = 0; y < 5; y++)
+			memset(bb.getBasePtr(0, y), 10 * (y + 1), 2);
+		comp.beginScene(2, 5);
+		Graphics::PixelFormat f = argb();
+		for (int classic = 0; classic < 2; classic++) {
+			comp.setClassic(classic != 0);
+			const Graphics::Surface &out = comp.compose(bb, 0, 0);
+			TS_ASSERT_EQUALS(out.w, 6);
+			TS_ASSERT_EQUALS(out.h, 18);
+			// game row 0 covers output rows [0, 3.6): three plain rows, then one blended row
+			for (int y = 0; y < 3; y++)
+				TS_ASSERT_EQUALS(px(out, 1, y), f.RGBToColor(10, 245, 5));
+			// row 3 = source rows 2 (weight 9) and 3 (weight 6): red (9 * 10 + 6 * 20) / 15
+			TS_ASSERT_EQUALS(px(out, 1, 3), f.RGBToColor(14, 241, 7));
+			for (int y = 4; y < 7; y++)
+				TS_ASSERT_EQUALS(px(out, 5, y), f.RGBToColor(20, 235, 10));
+			TS_ASSERT_EQUALS(px(out, 0, 17), f.RGBToColor(50, 205, 25));
+			// every row is a weighted mean of neighbours: red never decreases going down
+			for (int y = 1; y < 18; y++)
+				TS_ASSERT_LESS_THAN_EQUALS(px(out, 2, y - 1) >> 16 & 0xff, px(out, 2, y) >> 16 & 0xff);
+		}
+		bb.free();
+	}
+
+	void test_aspect_mouse() {
+		Remaster::AssetPack pack;
+		for (int wide = 0; wide < 2; wide++) {
+			for (int classic = 0; classic < 2; classic++) {
+				Remaster::Compositor comp(pack, 3, 320, 200, argb());
+				comp.setAspect(1.2f);
+				if (wide)
+					comp.setMaxExtension(54, 54);
+				comp.setClassic(classic != 0);
+				Graphics::Surface bb;
+				bb.create(320, 200, Graphics::PixelFormat::createFormatCLUT8());
+				memset(bb.getPixels(), 1, 320 * 200);
+				comp.beginScene(320, 200);
+				comp.compose(bb, 0, 0);
+				const int L = wide ? 54 * 3 : 0;
+				// extremes and centre
+				TS_ASSERT_EQUALS(comp.toGame(Common::Point(L, 0), 0), Common::Point(0, 0));
+				TS_ASSERT_EQUALS(comp.toGame(Common::Point(L + 959, 719), 0), Common::Point(319, 199));
+				TS_ASSERT_EQUALS(comp.toGame(Common::Point(L + 480, 360), 0), Common::Point(160, 100));
+				// no jumps: every output row maps to the same or the next game row, 3 or 4 rows each
+				int prev = 0, run = 0;
+				for (int Y = 0; Y < 720; Y++) {
+					int y = comp.toGame(Common::Point(L + 10, Y), 0).y;
+					TS_ASSERT(y == prev || y == prev + 1);
+					if (y != prev) {
+						TS_ASSERT(run == 3 || run == 4);
+						run = 0;
+					}
+					prev = y;
+					run++;
+				}
+				TS_ASSERT_EQUALS(prev, 199);
+				// and back: game -> screen -> game
+				for (int y = 0; y < 200; y++)
+					for (int x = 0; x < 320; x += 53) {
+						Common::Point s = comp.toScreen(Common::Point(x, y));
+						TS_ASSERT_EQUALS(comp.toGame(s, 0), Common::Point(x, y));
+					}
+				TS_ASSERT_EQUALS(comp.toScreen(Common::Point(0, 0)), Common::Point(L + 1, 1));
+				TS_ASSERT_EQUALS(comp.toScreen(Common::Point(319, 199)), Common::Point(L + 958, 718));
+				bb.free();
+			}
+		}
+	}
+
+	void test_square_pixels_unchanged() {
+		Remaster::AssetPack pack;
+		Remaster::Compositor a(pack, 3, 4, 3, argb()), b(pack, 3, 4, 3, argb());
+		b.setAspect(1.0f);
+		TS_ASSERT(!b.stretched());
+		TS_ASSERT_EQUALS(b.outputHeight(), 9);
+		byte pal[768];
+		makePalette(pal);
+		a.setPalette(pal, 0, 256);
+		b.setPalette(pal, 0, 256);
+		Graphics::Surface bb;
+		bb.create(4, 3, Graphics::PixelFormat::createFormatCLUT8());
+		byte *p = (byte *)bb.getPixels();
+		for (int i = 0; i < 12; i++)
+			p[i] = (byte)((i * 37) % 7);
+		a.beginScene(4, 3);
+		b.beginScene(4, 3);
+		const Graphics::Surface &oa = a.compose(bb, 0, 0);
+		const Graphics::Surface &ob = b.compose(bb, 0, 0);
+		TS_ASSERT_EQUALS(oa.h, 9);
+		TS_ASSERT_EQUALS(ob.h, 9);
+		for (int y = 0; y < 9; y++)
+			for (int x = 0; x < 12; x++)
+				TS_ASSERT_EQUALS(px(oa, x, y), px(ob, x, y));
+		for (int y = 0; y < 3; y++)
+			for (int x = 0; x < 4; x++) {
+				Common::Point s = b.toScreen(Common::Point(x, y));
+				TS_ASSERT_EQUALS(s, Common::Point(x * 3 + 1, y * 3 + 1));
+				TS_ASSERT_EQUALS(b.toGame(s, 0), Common::Point(x, y));
+			}
+		bb.free();
+	}
+};
